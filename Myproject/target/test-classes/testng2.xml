<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<test name="Check login with mail">
		<classes>
			<class name="Selinium.SeliniumXA">
				<methods>
					<include name="loginWithMailTest" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Wrong OTP Login">
		<classes>
			<class name="Selinium.SeliniumXA">
				<methods>
					<include name="loginWithPhoneNumber" />
				</methods>
			</class>
		</classes>
	</test>
	<test name="Verify the url">
		<classes>
			<class name="Selinium.SeliniumXA">
				<methods>
					<include name="verifyCurrentUrlTest" />
				</methods>
			</class>
		</classes>
	</test>
</suite>
