<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

    <test name="Click on profile section">
        <classes>
            <class name="Selinium.AaryaDigital">
                <methods>
                    <include name="login"/>
                    <include name="profile"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Check the URL OF THE PAGE">
        <classes>
            <class name="Selinium.AaryaDigital">
                <methods>
                    <include name="login"/>
                    <include name="url"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Click on subscription plan">
        <classes>
            <class name="Selinium.AaryaDigital">
                <methods>
                    <include name="login"/>
                    <include name="subscription"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Search on a video">
        <classes>
            <class name="Selinium.AaryaDigital">
                <methods>
                    <include name="login"/>
                    <include name="searchvideo"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Occassor">
        <classes>
            <class name="Selinium.Occassor">
                <methods>
                    <include name="Loginonoccasor"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
